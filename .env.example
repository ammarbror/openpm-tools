# BITBUCKET_EMAIL is optional if using Bitbucket API Token with Bearer auth
BITBUCKET_EMAIL=your-email@example.com
BITBUCKET_API_TOKEN=your-bitbucket-api-token
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
OBSIDIAN_VAULT_PATH=/path/to/your/Obsidian Vault

# Notion is the default. Set to obsidian only to opt into local Obsidian storage.
DOCUMENTS_PROVIDER=notion
NOTION_ROOT_PAGE_URL=

# LLM Enhancer Configuration for extract-knowledge
LLM_BASE_URL=https://rvcnnth.abc-tunnel.us/v1
LLM_MODEL=kira-free
LLM_API_KEY=your-llm-api-key

# Document Platform Auth Token (optional if Chrome is open with active session)
DOC_AUTH_TOKEN=

# Database Staging (Direct / Readonly)
DB_STAGING_HOST=db-staging.example.com
DB_STAGING_PORT=5432
DB_STAGING_USER=app_user
DB_STAGING_PASSWORD=your-staging-password
DB_STAGING_NAME=your-database-name

# Database Production (Readonly)
DB_PROD_HOST=db-prod.example.com
DB_PROD_PORT=5432
DB_PROD_USER=readonly_user
DB_PROD_PASSWORD=your-prod-readonly-password
DB_PROD_NAME=your-database-name

